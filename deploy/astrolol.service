# astrolol.service — run astrolol at boot and keep it running.
#
# ── LAYOUT ASSUMED BY THIS FILE ─────────────────────────────────────────────
#   /home/astrolol/venv        Python environment with astrolol installed
#   /home/astrolol/astrolol    git checkout (only for an install from source;
#                              holds the UI build in ui/dist)
#   /home/astrolol/.astrolol   settings, profiles and logs (created at first run)
#
# ── WHAT TO CHANGE ──────────────────────────────────────────────────────────
# 1. User= / Group=      The account astrolol runs as (default: astrolol).
# 2. ExecStart=          The `astrolol` command of the environment you installed
#                        it in. For another venv, use <venv>/bin/astrolol; for
#                        `pipx install` it is ~/.local/bin/astrolol of the
#                        service user.
# 3. WorkingDirectory=   Relative paths, such as the default images directory
#                        (./images), resolve here.
# 4. Environment=        Optional ASTROLOL_* overrides (see astrolol/config/
#                        settings.py), e.g. ASTROLOL_UI_DIST if the UI build is
#                        not found automatically.
#
# The server listens on 0.0.0.0:8000.
#
# ── ONE-TIME SETUP (as root) ────────────────────────────────────────────────
#   # create the service account; dialout = serial ports (EQMOD, focusers),
#   # plugdev = USB devices, video = cameras
#   sudo useradd --system --create-home --shell /usr/sbin/nologin astrolol
#   sudo usermod -aG dialout,plugdev,video astrolol
#
#   # install from source (the only way until astrolol is on PyPI)
#   sudo -u astrolol git clone <repo-url> /home/astrolol/astrolol
#   sudo -u astrolol python3 -m venv /home/astrolol/venv
#   sudo -u astrolol /home/astrolol/venv/bin/pip install -e /home/astrolol/astrolol
#   (cd /home/astrolol/astrolol/ui && sudo -u astrolol npm install && sudo -u astrolol npm run build)
#
# ── INSTALL ─────────────────────────────────────────────────────────────────
#   sudo cp /home/astrolol/astrolol/deploy/astrolol.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/astrolol.service      # apply the changes above
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now astrolol                # start now and at boot
#
# ── DAY TO DAY ──────────────────────────────────────────────────────────────
#   systemctl status astrolol
#   journalctl -u astrolol -f                           # live console output
#   sudo systemctl restart astrolol
#   sudo systemctl disable --now astrolol               # stop and don't start at boot
#
# After editing this file: `sudo systemctl daemon-reload && sudo systemctl restart astrolol`.
# Restarting from the UI (POST /admin/restart) re-execs the same process, so
# systemd keeps tracking it — nothing to configure for that.

[Unit]
Description=astrolol astronomy platform
# Wait for the network (clients connect over it) and for udev to have
# created the device nodes.
After=network-online.target systemd-udev-settle.service
Wants=network-online.target

# Never give up restarting: without this, systemd stops retrying after
# 5 starts in 10 seconds (the default start limit).
StartLimitIntervalSec=0

[Service]
Type=simple
User=astrolol
Group=astrolol
WorkingDirectory=/home/astrolol
ExecStart=/home/astrolol/venv/bin/astrolol

# Respawn whenever the process exits, whatever the reason (crash, kill, clean
# exit). Only `systemctl stop` keeps it down.
Restart=always
RestartSec=3

# Python: don't buffer output, so journalctl shows lines as they happen.
Environment=PYTHONUNBUFFERED=1
# Examples (uncomment to use):
#Environment=ASTROLOL_DATA_DIR=/var/lib/astrolol
#Environment=ASTROLOL_IMAGES_DIR=/home/astrolol/images

# Shutdown: SIGTERM first so running exposures/slews can be cancelled and
# hardware left in a sane state; SIGKILL after 20 s.
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
